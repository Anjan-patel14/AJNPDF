# AJN PDF R23 — copy only the values you actually use into .env.local / Vercel.
# Never commit real secrets.

# Firebase Authentication (web-visible values; safe to expose in browser config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase token verification / admin authorization (server-side project identity)
FIREBASE_PROJECT_ID=
AJN_ADMIN_EMAILS=

# Existing AJN backend analytics secret — server-only
AJN_ANALYTICS_ADMIN_TOKEN=
# Optional fallback used by the backend if a dedicated analytics token is not set
AJN_ADMIN_TOKEN=

# AJN processing backend
NEXT_PUBLIC_AJN_PDF_API_URL=https://ajn-pdf-api-rswf5f4f3q-el.a.run.app

# Razorpay Premium billing (R22)
NEXT_PUBLIC_AJN_RAZORPAY_ENABLED=
NEXT_PUBLIC_AJN_PREMIUM_30D_INR=
NEXT_PUBLIC_AJN_PREMIUM_365D_INR=
AJN_BILLING_INTERNAL_TOKEN=

# AJN ecosystem destinations — no fake links are rendered while blank
NEXT_PUBLIC_AJN_BUZZ_URL=
NEXT_PUBLIC_AJN_DESKTOP_DOWNLOAD_URL=
NEXT_PUBLIC_AJN_ANDROID_URL=
NEXT_PUBLIC_AJN_IOS_URL=

# Public API backend flags belong on Cloud Run/backend deployment, not Vercel client code
# AJN_PUBLIC_API_ENABLED=false
# AJN_PUBLIC_API_KEYS_JSON=[]
