# AJN PDF environment template.
# Keep this file placeholder-only. Never commit credentials, API secrets or private tokens.
# Copy to .env.local for the Next.js app and fill only the services you want to test.

# -----------------------------------------------------------------------------
# PDF backend
# -----------------------------------------------------------------------------

# Local example: http://127.0.0.1:8000
# Leave blank to use the validated production fallback configured by the app.
NEXT_PUBLIC_PDF_BACKEND_URL=
NEXT_PUBLIC_AJN_PDF_API_URL=

# -----------------------------------------------------------------------------
# Firebase Authentication
# -----------------------------------------------------------------------------

# Public Firebase web configuration used by email/password and Google sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firebase token verification. Usually the same project ID.
FIREBASE_PROJECT_ID=

# -----------------------------------------------------------------------------
# AJN PDF Premium / Razorpay
# -----------------------------------------------------------------------------

# Frontend pricing display and checkout availability.
# Keep disabled until both prices and the server-side billing stack are configured.
NEXT_PUBLIC_AJN_RAZORPAY_ENABLED=false
NEXT_PUBLIC_AJN_PREMIUM_30D_INR=
NEXT_PUBLIC_AJN_PREMIUM_365D_INR=

# Server-only token used by Next.js API routes when proxying authenticated billing
# requests to the FastAPI backend. Use a long random value and configure the exact
# same AJN_BILLING_INTERNAL_TOKEN in the backend environment.
AJN_BILLING_INTERNAL_TOKEN=

# Backend-only Razorpay and Premium settings. Do not expose these with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
AJN_PREMIUM_30D_PAISE=
AJN_PREMIUM_365D_PAISE=

# The FastAPI billing service stores orders/subscriptions in Firestore. For local
# development, authenticate Google Cloud using Application Default Credentials or
# set GOOGLE_APPLICATION_CREDENTIALS outside source control.
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# Analytics / search verification
# -----------------------------------------------------------------------------

NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# AJN PDF Public API v1
# -----------------------------------------------------------------------------
# Fail-closed by default.
# Generate API secrets locally from the backend tooling.
# Store only the generated SHA-256 API-key record; never commit plaintext API keys.
AJN_PUBLIC_API_ENABLED=false
AJN_PUBLIC_API_KEYS_JSON=
AJN_PUBLIC_API_RATE_PER_MINUTE=30

# -----------------------------------------------------------------------------
# Browser cloud integrations
# -----------------------------------------------------------------------------

# Google Drive: Google Identity Services + Picker + drive.file.
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=
NEXT_PUBLIC_GOOGLE_DRIVE_APP_ID=

# Dropbox Chooser.
NEXT_PUBLIC_DROPBOX_APP_KEY=

# Reserved for future MSAL.js authorization-code + PKCE OneDrive integration.
# Setting this value alone does not enable OneDrive.
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=
